opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  id: 'ChangeMe'
  name: 'ImportDocumentAI'
  validate_before_import: true # Validate any bundle before import
  scope: 'application/pdf,text/plain,text/html,text/markdown'
  auto: false # Enable/disable auto-import of file
  log_level: 'info'
  # xtm_one_intent: 'cti.stix_harvester' # XTM One intent for agent-based extraction

# import_document_ai:
  # include_relationships: true # Include relationships extracted from the document
  # create_indicator: false # Flag extracted observables for indicator creation
  # api_base_url: 'ChangeMe' # Base URL of the Import Document AI web service (legacy direct mode)
  # api_key: 'ChangeMe' # PEM licence/certificate key for the web service (legacy direct mode)
