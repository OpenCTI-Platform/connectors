opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  id: 'ChangeMe'
  name: 'IntelOwl' # optional (default: 'IntelOwl')
  scope: 'IPv4-Addr,IPv6-Addr,Domain-Name,Hostname,Url,StixFile' # optional (default shown)
  log_level: 'error' # optional (default: 'error')
  auto: false # optional, enable/disable auto-enrichment of OpenCTI entities (default: false)
  max_tlp: 'TLP:AMBER' # optional, available values: 'TLP:CLEAR', 'TLP:WHITE', 'TLP:GREEN', 'TLP:AMBER', 'TLP:AMBER+STRICT', 'TLP:RED' (default: 'TLP:AMBER')

intelowl:
  url: 'ChangeMe' # e.g. 'https://intelowl.example.com'
  api_key: 'ChangeMe'
  playbook: 'FREE_TO_USE_ANALYZERS' # optional (default: 'FREE_TO_USE_ANALYZERS')
  verify_ssl: true # optional (default: true)
  poll_interval: 5 # optional, seconds between job status checks (default: 5)
  job_timeout: 300 # optional, seconds to wait for a job (default: 300)
  update_score: true # optional, set the observable score from IntelOwl's verdict (default: true)
  create_labels: true # optional, add IntelOwl tags and malware family as labels (default: true)
