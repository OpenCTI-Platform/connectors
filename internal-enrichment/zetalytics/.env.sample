# OpenCTI connection
OPENCTI_URL=http://localhost:8080
OPENCTI_TOKEN=ChangeMe

# Connector identity
# Each deployed profile needs a unique ID and name.
# Uncomment and override these when running multiple profiles side by side.
#CONNECTOR_ID=00000000-0000-4000-8000-000000000101
#CONNECTOR_NAME=Zetalytics DNS - Analyst Enrichment
#CONNECTOR_SCOPE=Domain-Name,Hostname,IPv4-Addr,IPv6-Addr
#CONNECTOR_AUTO=false
#CONNECTOR_LOG_LEVEL=info

# Zetalytics API token (required)
ZETALYTICS_TOKEN=ChangeMe

# Enrichment profile - informational label; individual flags below control behaviour.
# Allowed: light | playbook | manual | deep
#ZETALYTICS_MODE=manual

# Maximum TLP level of observables this connector will enrich.
# Observables marked above this level are silently skipped.
# Allowed: TLP:CLEAR | TLP:GREEN | TLP:AMBER | TLP:AMBER+STRICT | TLP:RED
#ZETALYTICS_MAX_TLP=TLP:AMBER

# --- Data volume controls ---
# Maximum passive DNS records returned per query
#ZETALYTICS_MAX_RESULTS=300
# Maximum subdomains to retrieve (0 = disabled)
#ZETALYTICS_MAX_SUBDOMAINS=300
# Maximum historical WHOIS records (0 = disabled)
#ZETALYTICS_MAX_WHOIS_RESULTS=5
# Maximum results for nameserver pivot queries
#ZETALYTICS_MAX_NS_PIVOT_RESULTS=100
# How many days of history to query
#ZETALYTICS_LOOKBACK_DAYS=365
# Timestamp field to filter records on. Allowed: all | last_seen | first_seen
#ZETALYTICS_TSFIELD=all

# --- Endpoint feature flags ---
#ZETALYTICS_INCLUDE_LIVE_DNS=true
#ZETALYTICS_INCLUDE_SUBDOMAINS=true
#ZETALYTICS_INCLUDE_D8S=true
#ZETALYTICS_INCLUDE_HISTORICAL_WHOIS=false
#ZETALYTICS_INCLUDE_NS_GLUE=true
#ZETALYTICS_INCLUDE_NS2DOMAIN=false
#ZETALYTICS_INCLUDE_MX2DOMAIN=false
#ZETALYTICS_INCLUDE_EMAIL_PIVOTS=false

# --- STIX output controls ---
#ZETALYTICS_CONFIDENCE=60
#ZETALYTICS_MARKING_DEFINITION=TLP:AMBER
#ZETALYTICS_CREATE_NOTE_WHEN_NO_RESULTS=false
