{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/google-safebrowsing_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "Google Safe Browsing",
      "description": "The name of the connector.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "Url",
        "Domain-Name",
        "Hostname"
      ],
      "description": "The scope of the connector.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "error",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "INTERNAL_ENRICHMENT",
      "default": "INTERNAL_ENRICHMENT",
      "type": "string"
    },
    "CONNECTOR_AUTO": {
      "default": false,
      "description": "Whether the connector should run automatically when an entity is created or updated.",
      "type": "boolean"
    },
    "CONNECTOR_MAX_TLP": {
      "description": "The highest TLP of the entities the connector is allowed to enrich. Entities marked with a higher TLP are skipped and never sent to the external source.",
      "enum": [
        "clear",
        "white",
        "green",
        "amber",
        "amber+strict",
        "red"
      ],
      "type": "string",
      "default": "amber"
    },
    "SAFE_BROWSING_API_KEY": {
      "description": "Safe Browsing API key (Google or Yandex).",
      "format": "password",
      "minLength": 1,
      "type": "string",
      "writeOnly": true
    },
    "SAFE_BROWSING_API_URL": {
      "default": "https://safebrowsing.googleapis.com/",
      "description": "Safe Browsing API base URL. Use `https://sba.yandex.net` for Yandex Safe Browsing.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "GOOGLE_SAFE_BROWSING_API_KEY": {
      "default": null,
      "description": "Use SAFE_BROWSING_API_KEY instead.",
      "format": "password",
      "type": "string",
      "writeOnly": true,
      "deprecated": true
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN",
    "SAFE_BROWSING_API_KEY"
  ],
  "additionalProperties": true
}