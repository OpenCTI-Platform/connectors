FROM filigran/alpine-python-fips:python3.12
ENV CONNECTOR_TYPE=INTERNAL_ENRICHMENT

COPY src /opt/opencti-connector-cve/src
WORKDIR /opt/opencti-connector-cve

RUN apk --no-cache add git && \
    pip3 install --no-cache-dir -r src/requirements.txt && \
    pip3 install --no-cache-dir --upgrade --no-deps -r src/requirements-overrides.txt && \
    apk del git && \
    addgroup -S appgroup && adduser -S appuser -G appgroup && \
    chown -R appuser:appgroup /opt/opencti-connector-cve

USER appuser

CMD ["python", "-m", "src"]
