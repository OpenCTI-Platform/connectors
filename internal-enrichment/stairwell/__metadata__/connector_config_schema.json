{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/stairwell_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "Stairwell",
      "description": "The name of the connector.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "StixFile",
        "Domain-Name",
        "IPv4-Addr",
        "IPv6-Addr",
        "Autonomous-System"
      ],
      "description": "The observable types the connector enriches.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "error",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "INTERNAL_ENRICHMENT",
      "default": "INTERNAL_ENRICHMENT",
      "type": "string"
    },
    "CONNECTOR_AUTO": {
      "default": false,
      "description": "Whether the connector should run automatically when an entity is created or updated.",
      "type": "boolean"
    },
    "CONNECTOR_MAX_TLP": {
      "description": "The highest TLP of the entities the connector is allowed to enrich. Entities marked with a higher TLP are skipped and never sent to the external source.",
      "enum": [
        "clear",
        "white",
        "green",
        "amber",
        "amber+strict",
        "red"
      ],
      "type": "string",
      "default": "amber"
    },
    "STAIRWELL_API_TOKEN": {
      "description": "Stairwell API token (Bearer auth).",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "STAIRWELL_API_BASE_URL": {
      "default": "https://app.stairwell.com",
      "description": "Stairwell API base URL.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "STAIRWELL_ORGANIZATION_ID": {
      "default": "",
      "description": "Optional Stairwell organization id (rate-limit header).",
      "type": "string"
    },
    "STAIRWELL_USER_ID": {
      "default": "",
      "description": "Optional Stairwell user id (rate-limit header).",
      "type": "string"
    },
    "STAIRWELL_DEFAULT_TLP": {
      "default": "amber",
      "description": "TLP marking applied to entities created by enrichment.",
      "enum": [
        "clear",
        "white",
        "green",
        "amber",
        "amber+strict",
        "red"
      ],
      "type": "string"
    },
    "STAIRWELL_VARIANT_LIMIT": {
      "default": 25,
      "description": "Max variant SCOs per file enrichment (0 disables).",
      "type": "integer"
    },
    "STAIRWELL_RESOLUTIONS_LIMIT": {
      "default": 50,
      "description": "Max DNS resolution rows per domain (0 disables).",
      "type": "integer"
    },
    "STAIRWELL_SIGHTINGS_LIMIT": {
      "default": 0,
      "description": "Max unique assets per file; 0 (the default) disables sightings. Enabling writes asset names, environment ids, and file paths into OpenCTI.",
      "type": "integer"
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN",
    "STAIRWELL_API_TOKEN"
  ],
  "additionalProperties": true
}