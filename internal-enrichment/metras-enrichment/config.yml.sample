opencti:
  url: 'http://localhost:8080'
  token: 'ChangeMe'

connector:
  id: 'ChangeMe'  # UUIDv4
  name: 'Metras-Enrichment'
  scope: 'IPv4-Addr,StixFile'
  log_level: 'error'
  auto: false
  max_tlp: 'TLP:AMBER+STRICT'

metras:
  api_base_url: 'https://api.metras.sa/api'
  api_key: 'ChangeMe'
  verify_ssl: true
