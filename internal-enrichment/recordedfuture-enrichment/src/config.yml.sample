opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  type: 'INTERNAL_ENRICHMENT'
  id: 'ChangeMe'
  name: 'Recorded Future Enrichment'
  scope: 'ipv4-addr,ipv6-addr,domain-name,url,stixfile,vulnerability'
  log_level: 'error'
  max_tlp: 'TLP:AMBER'

recorded_future:
  token: 'ChangeMe'
  create_indicator_threshold: 0
  vulnerability_enrichment_optional_fields: 'aiInsights,cpe,risk'
  #threat_actor_to_intrusion_set: False
