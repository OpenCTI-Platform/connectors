opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  id: 'ChangeMe'
  #name: 'RST Noise Control'
  #scope: 'IPv4-Addr,Domain-Name,Url,StixFile,indicator'
  #auto: false # Enable/disable auto-enrichment of observables
  #log_level: 'error'
  #max_tlp: 'TLP:AMBER+STRICT' # Available values: TLP:CLEAR, TLP:WHITE, TLP:GREEN, TLP:AMBER, TLP:AMBER+STRICT, TLP:RED

rst_noise_control:
  api_key: 'ChangeMe'
  #base_url: 'https://api.rstcloud.net/v1'
