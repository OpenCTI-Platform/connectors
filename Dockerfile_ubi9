# syntax=docker/dockerfile:1.28
FROM registry.access.redhat.com/ubi9/ubi-minimal

# Runtime packages of the connector, under their UBI9 names (set in .build.env).
ARG EXTRA_PACKAGES_UBI9=""

RUN <<EOT
    set -euxo pipefail

    microdnf -y upgrade --refresh
    microdnf -y --setopt=install_weak_deps=0 install python3.12 ${EXTRA_PACKAGES_UBI9}
    microdnf clean all
EOT

ENV PYTHONDONTWRITEBYTECODE=1
# Keeps Python from buffering stdout and stderr, so that a crash still shows its logs.
ENV PYTHONUNBUFFERED=1

# Provide a dedicated HOME so tools that build per-user caches/config under "~"
# (e.g. POST_INSTALL steps) have a valid writable location at build time and a
# readable one at runtime for arbitrary non-root UIDs (OpenShift/Kubernetes).
# HOME defaulting to "/" would otherwise fail with a PermissionError.
ENV HOME=/opt/opencti-connector
RUN mkdir -p "$HOME"

ARG CONNECTOR_TYPE
ENV CONNECTOR_TYPE=${CONNECTOR_TYPE}

ARG CONNECTOR_CMD="main.py"
ARG CONNECTOR_WORKDIR="/opt/connector/src"
ARG POST_INSTALL=""
# Directories the connector writes to at runtime, made writable for any UID.
ARG WRITABLE_DIRS=""

ENV CONNECTOR_CMD=${CONNECTOR_CMD}

COPY src /opt/connector/src

RUN <<EOT
    set -euxo pipefail

    # 'microdnf remove' leaves the dependencies of what it removes, so every
    # package installed for the build is listed and removed at the end.
    rpm -qa --qf '%{NAME}\n' | sort > /tmp/packages-before
    microdnf -y --setopt=install_weak_deps=0 install python3.12-pip git-core
    pip3.12 install --no-cache-dir --requirement /opt/connector/src/requirements.txt
    # Builds from source still leave caches under HOME (pip build isolation, cargo).
    rm -rf "$HOME/.cache/pip" "$HOME/.cargo"
    # POST_INSTALL is a shell command line, so it can chain commands (&&).
    if [ -n "${POST_INSTALL}" ]; then sh -c "${POST_INSTALL}"; fi
    # Make anything created under HOME at build time (e.g. POST_INSTALL caches)
    # world-readable so the connector can read it as an arbitrary non-root UID.
    chmod -R a+rX "$HOME"
    if [ -n "${WRITABLE_DIRS}" ]; then mkdir -p ${WRITABLE_DIRS} && chmod -R a+rwX ${WRITABLE_DIRS}; fi
    rpm -qa --qf '%{NAME}\n' | sort | comm -13 /tmp/packages-before - | xargs microdnf -y remove
    rm /tmp/packages-before
    microdnf clean all
EOT

WORKDIR ${CONNECTOR_WORKDIR}

# exec ensures python3.12 replaces the shell process and receives OS signals
# (SIGTERM, SIGINT) directly as PID 1, while sh -c preserves the ${CONNECTOR_CMD}
# variable expansion needed for per-connector overrides.
CMD ["sh", "-c", "exec python3.12 ${CONNECTOR_CMD}"]
