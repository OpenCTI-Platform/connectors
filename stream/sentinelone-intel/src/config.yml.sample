opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  type: 'STREAM'
  id: 'ChangeMe'
  name: 'SentinelOne Intel Stream Connector'
  # scope: 'sentinelone'
  # log_level: 'error'
  live_stream_id: 'ChangeMe' # `live` or ID of the live stream created in the OpenCTI UI
  # live_stream_listen_delete: true
  # live_stream_no_dependencies: true

sentinelone_intel:
  url: 'ChangeMe'
  api_key: 'ChangeMe'
  # need at least one of account_id, group_id, or site_id
  # account_id and site_id cannot be used simultaneously
  # account_id: 'ChangeMeOrEmpty'
  # site_id: 'ChangeMeOrEmpty'
  # group_id: 'ChangeMeOrEmpty'

# Dissemination assurance (deployment write-back to OpenCTI)
#deployment:
#  reporting_enabled: true # Optional (default: true)
#  reconciliation_interval: 60 # Optional (default: 60 minutes, 0 disables the reconciliation)
#security_platform:
#  name: 'SentinelOne' # Optional (default: 'SentinelOne')
#  type: 'EDR' # Optional (default: 'EDR')
#  id: 'ChangeMe' # Optional (existing Security Platform entity id)