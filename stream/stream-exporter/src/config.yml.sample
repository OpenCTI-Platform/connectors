opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  type: 'STREAM'
  id: 'ChangeMe'
  live_stream_id: 'ChangeMe' # ID of the live stream created in the OpenCTI UI
  live_stream_listen_delete: true
  live_stream_no_dependencies: false
  name: 'StreamExporterConnector'
  scope: 'stream-exporter' # Reserved
  log_level: 'debug'

stream_exporter:
  s3_endpoint: 'localhost'
  s3_port: 443
  s3_bucket: 'opencti-export'
  s3_folder: 'opencti-stream'
  s3_access_key: 'ChangeMe'
  s3_secret_key: 'ChangeMe'
  s3_secure: true
