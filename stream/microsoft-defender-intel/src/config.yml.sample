opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  #id: '4aa40d9f-bee0-466e-a72e-6878c13bde08' # Optional (default: '4aa40d9f-bee0-466e-a72e-6878c13bde08')
  #name: 'Microsoft Defender Intel' # Optional (default: 'Microsoft Defender Intel')
  #scope: 'defender' # Optional (default: 'defender')
  #live_stream_id: 'ChangeMe' # Optional (default: 'live')
  #log_level: 'error' # Optional (default: 'error')

microsoft_defender_intel:
  tenant_id: 'ChangeMe'
  client_id: 'ChangeMe'
  client_secret: 'ChangeMe'
  #base_url: 'https://api.securitycenter.microsoft.com' # Optional (default: 'https://api.securitycenter.microsoft.com')
  #resource_path: 'api/indicators' # Optional (default: '/api/indicators')
  #action: 'Alert' # Optional (default: 'Alert')
  #expire_time: 30 # Optional (default: 30)
  #passive_only: false # Optional (default: false)

# Dissemination assurance (deployment write-back to OpenCTI)
#deployment:
  #reporting_enabled: true # Optional (default: true)
  #reconciliation_interval: 60 # Optional (default: 60 minutes, 0 disables the reconciliation)
#hits:
  #reporting_enabled: true # Optional (default: true, requires the Alert.Read.All permission)
#security_platform:
  #name: 'Microsoft Defender for Endpoint' # Optional (default: 'Microsoft Defender for Endpoint')
  #type: 'EDR' # Optional (default: 'EDR')
  #id: 'ChangeMe' # Optional (existing Security Platform entity id)
