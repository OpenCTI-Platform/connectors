opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  id: 'ChangeMe'
  # name: 'Zscaler' # optional (default: 'Zscaler')
  # scope: 'domain-name' # optional (default: 'domain-name')
  # log_level: 'info' # optional (default: 'info')
  live_stream_id: 'ChangeMe' # ID of the live stream created in the OpenCTI UI
  # live_stream_listen_delete: true # optional (default: true)
  # live_stream_no_dependencies: true # optional (default: true)

zscaler:
  client_id: 'ChangeMe' # ZIdentity API client ID
  client_secret: 'ChangeMe' # ZIdentity API client secret
  vanity_domain: 'ChangeMe' # <vanity_domain> in https://<vanity_domain>.zslogin.net
  # cloud: 'beta' # optional (default: production cloud, api.zsapi.net)
  # blacklist_name: 'BLACK_LIST_DYNDNS' # optional, URL category ID such as CUSTOM_01 (default: 'BLACK_LIST_DYNDNS')
  # ssl_verify: true # optional (default: true)
