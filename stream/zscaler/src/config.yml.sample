opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  id: 'ChangeMe'
  # name: 'Zscaler' # optional (default: 'Zscaler')
  # scope: 'domain-name' # optional (default: 'domain-name')
  # log_level: 'info' # optional (default: 'info')
  live_stream_id: 'ChangeMe' # ID of the live stream created in the OpenCTI UI
  # live_stream_listen_delete: true # optional (default: true)
  # live_stream_no_dependencies: true # optional (default: true)

zscaler:
  username: 'ChangeMe'
  password: 'ChangeMe'
  api_key: 'ChangeMe'
  # blacklist_name: 'BLACK_LIST_DYNDNS' # optional (default: 'BLACK_LIST_DYNDNS')
  # ssl_verify: false # optional (default: false)

# Dissemination assurance (deployment write-back to OpenCTI)
#deployment:
#  reporting_enabled: true # optional (default: true)
#  reconciliation_interval: 60 # optional (default: 60 minutes, 0 disables the reconciliation)
#security_platform:
#  name: 'Zscaler Internet Access' # optional (default: 'Zscaler Internet Access')
#  type: 'ChangeMe' # optional (default: none)
#  id: 'ChangeMe' # optional (existing Security Platform entity id)
