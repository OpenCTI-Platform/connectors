opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  type: 'INTERNAL_ENRICHMENT'
  id: 'ChangeMe'
  name: 'Template Connector' # optional (default: 'TemplateConnector')
  scope: 'IPv4-Addr' # optional, OpenCTI entity types to enrich, each handled by a processor (default: 'IPv4-Addr')
  log_level: 'error' # optional (default: 'error')
  auto: false # optional, enable/disable auto-enrichment of OpenCTI entities (default: false)
  max_tlp: 'green' # optional, highest TLP of the entities to enrich, available values: 'clear', 'white', 'green', 'amber', 'amber+strict', 'red' (default: 'green')

template:
  api_base_url: 'https://api.example.com/v1' # optional (default: 'https://api.example.com/v1')
  api_key: 'ChangeMe'
  create_autonomous_system: true # optional, create the autonomous system of the IP address (default: true)
