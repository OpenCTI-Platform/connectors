FROM filigran/alpine-python-fips:python3.12
ENV CONNECTOR_TYPE=INTERNAL_EXPORT_FILE

COPY src /opt/opencti-connector-export-file-stix
WORKDIR /opt/opencti-connector-export-file-stix

RUN apk --no-cache add git && \
    pip3 install --no-cache-dir -r requirements.txt && \
    apk del git

CMD ["python3", "export-file-stix.py"]
