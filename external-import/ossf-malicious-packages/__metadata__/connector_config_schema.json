{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/ossf_malicious_packages_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "OSSF Malicious Packages",
      "description": "The name of the connector.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "file",
        "indicator"
      ],
      "description": "The scope of the connector.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "error",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "EXTERNAL_IMPORT",
      "default": "EXTERNAL_IMPORT",
      "type": "string"
    },
    "CONNECTOR_DURATION_PERIOD": {
      "default": "PT1H",
      "description": "The period of time to await between two runs of the connector.",
      "format": "duration",
      "type": "string"
    },
    "OSSF_GITHUB_REPO_URL": {
      "description": "URL of the OSSF malicious-packages GitHub repository to clone/pull.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OSSF_BRANCH": {
      "default": "main",
      "description": "Git branch to track in the OSSF malicious-packages repository.",
      "type": "string"
    },
    "OSSF_LOCAL_REPO_PATH": {
      "default": "/opt/ossf-malicous-packages-repo",
      "description": "Local filesystem path where the OSSF repository is cloned.",
      "type": "string"
    },
    "OSSF_DEFAULT_SCORE": {
      "default": 80,
      "description": "Default score assigned to created indicators (0-100).",
      "type": "integer"
    },
    "OSSF_SOURCE_NAME": {
      "default": "ossf/malicious-packages",
      "description": "Source name label applied to created entities.",
      "type": "string"
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN",
    "OSSF_GITHUB_REPO_URL"
  ],
  "additionalProperties": true
}
