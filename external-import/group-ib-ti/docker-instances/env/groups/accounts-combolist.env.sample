CONNECTOR_DOCKER_CONTAINER_NAME=gib-accounts-combolist
# Generate one with uuidgen (https://www.uuidgenerator.net/version4)
CONNECTOR_ID=ChangeMe
CONNECTOR_NAME=Group-IB Connector Compromised Accounts (Combolist)

TI_API_COLLECTIONS_COMPROMISED_ACCOUNT_GROUP_DEFAULT_DATE=
TI_API_COLLECTIONS_COMPROMISED_ACCOUNT_GROUP_ENABLE=false
TI_API_COLLECTIONS_COMPROMISED_ACCOUNT_GROUP_LOCAL_CUSTOM_TAG=null
