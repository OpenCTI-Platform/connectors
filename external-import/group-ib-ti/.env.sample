# === OpenCTI Server ===
# http://opencti:8080 - for docker deployment, http://localhost:8080 - for manual deployment
OPENCTI_URL=http://localhost
# Use one as provided by the OpenCTI platform
OPENCTI_TOKEN=ChangeMe

# === OpenCTI Connector ===
# Docker container name
CONNECTOR_DOCKER_CONTAINER_NAME=gib_connector
# Generate one with uuidgen (https://www.uuidgenerator.net/version4)
# A default UUID is built in; set your own when running several instances
# (see docker-instances/) so they do not share one identity in OpenCTI.
CONNECTOR_ID=ChangeMe
CONNECTOR_NAME=Group-IB Connector
CONNECTOR_SCOPE=stix2,report,threat-actor,intrusion-set,malware,attack-pattern,vulnerability,indicator,location,identity,incident,note,relationship,ipv4-addr,ipv6-addr,domain,url,StixFile,email-addr,user-account,payment-card,bank-account
# One of the following: debug, info, warning, error
CONNECTOR_LOG_LEVEL="info"
# Specifies the time interval in ISO 8601 format (Duration):
# Format: P[n]Y[n]M[n]DT[n]H[n]M[n]S
# - P: indicates the beginning of the period (Period).
# - T: separates date and time, used before time components.
# - n: a number representing a quantity (e.g. 3 for 3 minutes).
#
# Examples:
# - PT3M: an interval of 3 minutes.
# - PT5S: an interval of 5 seconds.
# - P1DT2H: an interval of 1 day and 2 hours.
CONNECTOR_DURATION_PERIOD=PT4H

# === RabbitMQ Server used for integration manual run ===
CONNECTOR_MQ_HOST=localhost
CONNECTOR_MQ_PORT=5672
CONNECTOR_MQ_VHOST=/
CONNECTOR_MQ_USE_SSL=false
CONNECTOR_MQ_USER=guest
CONNECTOR_MQ_PASS=guest

# === Threat Intelligence API Server ===
# Variable naming: every TI_API_* variable is a single-underscore name of the form
# TI_API_<FIELD> (TI_API_PROXY_IP, TI_API_EXTRA_SETTINGS_<KEY>,
# TI_API_COLLECTIONS_<COLLECTION>_<KEY>), as exposed to the connector manager.
# The former double-underscore spelling (TI_API__PROXY__IP, ...) is still
# accepted but deprecated: it logs a warning at startup.
# Connector specific parameters. Username and token are mandatory.
TI_API_URL=https://tap.group-ib.com/api/v2/
TI_API_USERNAME=ChangeMe
TI_API_TOKEN=ChangeMe

# === Threat Intelligence API Proxy ===
# Proxy specifc parameters. You can leave them blank.
TI_API_PROXY_IP=
TI_API_PROXY_PORT=
TI_API_PROXY_PROTOCOL=
TI_API_PROXY_USERNAME=
TI_API_PROXY_PASSWORD=

# Threat Intelligence Collections settings
TI_API_EXTRA_SETTINGS_IGNORE_NON_INDICATOR_THREAT_REPORTS=false
TI_API_EXTRA_SETTINGS_IGNORE_NON_INDICATOR_THREATS=false
TI_API_EXTRA_SETTINGS_IGNORE_NON_MALWARE_DDOS=true
TI_API_EXTRA_SETTINGS_INTRUSION_SET_INSTEAD_OF_THREAT_ACTOR=false
TI_API_EXTRA_SETTINGS_TIME_OUTPUT_FORMAT='%Y-%m-%d %H:%M:%S'
TI_API_EXTRA_SETTINGS_ENABLE_STATEMENT_MARKING=false
# When true, the connector omits x_opencti_labels from STIX bundles so the OpenCTI
# worker's update path does not overwrite labels that were added manually by
# analysts. Trade-off: connector-supplied labels also stop being (re)applied.
TI_API_EXTRA_SETTINGS_PRESERVE_MANUAL_LABELS=false

# Development only: write logs to rotating files (connector.log inside LOG_FILE_DIR)
# Not intended for production use. Ensure the directory is mounted as a volume in docker-compose.yml
TI_API_EXTRA_SETTINGS_ENABLE_FILE_LOGGING=false
TI_API_EXTRA_SETTINGS_LOG_FILE_DIR=/opt/connector/logs
TI_API_EXTRA_SETTINGS_LOG_FILE_MAX_BYTES=10485760
TI_API_EXTRA_SETTINGS_LOG_FILE_BACKUP_COUNT=5

# === Collections ===
# DEFAULT_DATE — initial lookback for the FIRST run only (YYYY-MM-DD). After the first
# run, the sequpdate cursor from the API takes over and DEFAULT_DATE is ignored.
# Strongly recommended for every collection you ENABLE: fill in an explicit date —
# see README section "Recommended DEFAULT_DATE per collection" for the suggested
# lookback per collection. If left empty, the API adapter falls back to today
# minus 3 days for the initial seqUpdate lookup.

TI_API_COLLECTIONS_APT_THREAT_DEFAULT_DATE=
TI_API_COLLECTIONS_APT_THREAT_ENABLE=false
TI_API_COLLECTIONS_APT_THREAT_LOCAL_CUSTOM_TAG=null
TI_API_COLLECTIONS_APT_THREAT_TTL=1460
TI_API_COLLECTIONS_APT_THREAT_USE_HUNTING_RULES=false
TI_API_COLLECTIONS_APT_THREAT_STORE_REPORT_LABELS_IN_NOTE=false
TI_API_COLLECTIONS_APT_THREAT_ADD_THREAT_ACTOR_LABEL_TO_OBSERVABLES=true
TI_API_COLLECTIONS_APT_THREAT_INCLUDE_THREAT_ACTOR_LABELS=true
TI_API_COLLECTIONS_APT_THREAT_INCLUDE_NATION_STATE_LABEL=true
TI_API_COLLECTIONS_APT_THREAT_INCLUDE_CONTEXT_LABEL=true
TI_API_COLLECTIONS_APT_THREAT_DESCRIPTION_IN_EXTERNAL_REFERENCES=false
# Promote report victimology into searchable SDOs: sectors -> Identity (Sector),
# targetedCompany / targetedPartnersAndClients -> Identity (Organization),
# regions -> Location (Region); linked as "<actor> targets <entity>" when the
# report carries a threat actor.
TI_API_COLLECTIONS_APT_THREAT_TARGETED_ENTITIES_AS_SDO=true
# Add expertise labels (bare values) from the report "expertise" field.
TI_API_COLLECTIONS_APT_THREAT_INCLUDE_EXPERTISE_LABELS=true

TI_API_COLLECTIONS_APT_THREAT_ACTOR_DEFAULT_DATE=
TI_API_COLLECTIONS_APT_THREAT_ACTOR_ENABLE=false
TI_API_COLLECTIONS_APT_THREAT_ACTOR_LOCAL_CUSTOM_TAG=null
TI_API_COLLECTIONS_APT_THREAT_ACTOR_TTL=1460
TI_API_COLLECTIONS_APT_THREAT_ACTOR_USE_HUNTING_RULES=false
TI_API_COLLECTIONS_APT_THREAT_ACTOR_INCLUDE_NATION_STATE_LABEL=true
TI_API_COLLECTIONS_APT_THREAT_ACTOR_DESCRIPTION_IN_EXTERNAL_REFERENCES=false

TI_API_COLLECTIONS_ATTACKS_DDOS_DEFAULT_DATE=
TI_API_COLLECTIONS_ATTACKS_DDOS_ENABLE=false
TI_API_COLLECTIONS_ATTACKS_DDOS_LOCAL_CUSTOM_TAG=null
TI_API_COLLECTIONS_ATTACKS_DDOS_TTL=10
TI_API_COLLECTIONS_ATTACKS_DDOS_USE_HUNTING_RULES=false
# CnC (attacker) domain/url/ip become Indicators; target stays a plain observable.
TI_API_COLLECTIONS_ATTACKS_DDOS_CNC_AS_INDICATOR=true
# Create an Incident SDO per DDoS attack (linked to observables/malware/actor).
TI_API_COLLECTIONS_ATTACKS_DDOS_CREATE_INCIDENT=true

TI_API_COLLECTIONS_ATTACKS_DEFACE_DEFAULT_DATE=
TI_API_COLLECTIONS_ATTACKS_DEFACE_ENABLE=false
TI_API_COLLECTIONS_ATTACKS_DEFACE_LOCAL_CUSTOM_TAG=null
TI_API_COLLECTIONS_ATTACKS_DEFACE_TTL=10
# Create an Incident SDO per defacement (linked to observables/actor/location).
TI_API_COLLECTIONS_ATTACKS_DEFACE_CREATE_INCIDENT=true

TI_API_COLLECTIONS_ATTACKS_PHISHING_GROUP_DEFAULT_DATE=
TI_API_COLLECTIONS_ATTACKS_PHISHING_GROUP_ENABLE=false
TI_API_COLLECTIONS_ATTACKS_PHISHING_GROUP_LOCAL_CUSTOM_TAG=null
TI_API_COLLECTIONS_ATTACKS_PHISHING_GROUP_TTL=5
TI_API_COLLECTIONS_ATTACKS_PHISHING_GROUP_USE_HUNTING_RULES=false
# Impersonated brand -> Identity (Organization) linked to the phishing observables.
TI_API_COLLECTIONS_ATTACKS_PHISHING_GROUP_BRAND_AS_IDENTITY=true
# Add brand labels (bare brand names) to all emitted entities of the event.
TI_API_COLLECTIONS_ATTACKS_PHISHING_GROUP_INCLUDE_BRAND_LABELS=true

TI_API_COLLECTIONS_ATTACKS_PHISHING_KIT_DEFAULT_DATE=
TI_API_COLLECTIONS_ATTACKS_PHISHING_KIT_ENABLE=false
TI_API_COLLECTIONS_ATTACKS_PHISHING_KIT_LOCAL_CUSTOM_TAG=null
TI_API_COLLECTIONS_ATTACKS_PHISHING_KIT_TTL=30
TI_API_COLLECTIONS_ATTACKS_PHISHING_KIT_USE_HUNTING_RULES=false
# targetBrand values -> Identity (Organization) linked to the kit observables.
TI_API_COLLECTIONS_ATTACKS_PHISHING_KIT_BRAND_AS_IDENTITY=true
TI_API_COLLECTIONS_ATTACKS_PHISHING_KIT_INCLUDE_BRAND_LABELS=true

TI_API_COLLECTIONS_COMPROMISED_ACCESS_DEFAULT_DATE=
