TI_API_COLLECTIONS_COMPROMISED_ACCESS_CNC_AS_INDICATOR=true
# Emit target.host/domain/ip as plain observables so customers can search their assets.
TI_API_COLLECTIONS_COMPROMISED_ACCESS_TARGET_OBSERVABLES=true

