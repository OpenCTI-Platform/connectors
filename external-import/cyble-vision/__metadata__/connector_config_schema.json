{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/cyble-vision_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "Cyble Vision",
      "description": "Display name in OpenCTI.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "Incident",
        "Report",
        "Note",
        "Indicator",
        "Vulnerability",
        "Intrusion-Set",
        "Domain-Name",
        "IPv4-Addr",
        "Url",
        "X509-Certificate",
        "User-Account"
      ],
      "description": "Descriptive entity types this connector imports.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "error",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "EXTERNAL_IMPORT",
      "default": "EXTERNAL_IMPORT",
      "type": "string"
    },
    "CONNECTOR_DURATION_PERIOD": {
      "default": "PT1H",
      "description": "Wait time between runs, as an ISO-8601 duration.",
      "format": "duration",
      "type": "string"
    },
    "CYBLE_VISION_API_BASE_URL": {
      "default": "https://bifrost.cyble.ai",
      "description": "Cyble Vision API base URL.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "CYBLE_VISION_API_TOKEN": {
      "description": "Cyble Vision API bearer token.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CYBLE_VISION_IMPORT_SINCE": {
      "description": "Lookback on the first run. Absolute ISO datetime or relative duration such as P7D.",
      "pattern": "^(?:(?!0000|0001|9999)(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)(?:[T ](?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|[+-](?:[01]\\d|2[0-3])(?::?[0-5]\\d)?)?)?|P(?!$)(?:\\d{1,3}Y)?(?:\\d{1,3}M)?(?:\\d{1,3}W)?(?:\\d{1,4}D)?(?:T(?=\\d)(?:\\d{1,4}H)?(?:\\d{1,4}M)?(?:\\d{1,4}(?:\\.\\d+)?S)?)?)$",
      "type": "string"
    },
    "CYBLE_VISION_ALERT_SERVICES": {
      "default": [],
      "description": "Allow-list of Vision service names. Empty means every entitled service from GET /y/services.",
      "examples": [
        "ssl_expiry,darkweb_data_breaches,advisory,flash_report"
      ],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CYBLE_VISION_EXCLUDE_STATUSES": {
      "default": [
        "FALSE_POSITIVE"
      ],
      "description": "Alert statuses to omit from import.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CYBLE_VISION_PAGE_SIZE": {
      "default": 100,
      "description": "Alerts API page size (skip/take).",
      "maximum": 500,
      "minimum": 1,
      "type": "integer"
    },
    "CYBLE_VISION_TLP_LEVEL": {
      "description": "TLP marking applied to every imported object.",
      "enum": [
        "clear",
        "white",
        "green",
        "amber",
        "amber+strict",
        "red"
      ],
      "type": "string",
      "default": "amber"
    },
    "CYBLE_VISION_PORTAL_URL_TEMPLATE": {
      "default": "https://cyble.ai/alerts/{service}?id=[\"{alert_id}\"]",
      "description": "Deep-link template. Placeholders: {service}, {alert_id}.",
      "type": "string"
    },
    "CYBLE_VISION_ENGINE_API_BASE_URL": {
      "default": "https://api.cyble.ai",
      "description": "Cyble engine API base URL for advisories, newsfeed, and newsflash.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "CYBLE_VISION_ENABLE_ADVISORIES": {
      "default": true,
      "description": "Import research advisories from the engine API.",
      "type": "boolean"
    },
    "CYBLE_VISION_ENABLE_NEWSFEED": {
      "default": true,
      "description": "Import newsfeed articles from the engine API.",
      "type": "boolean"
    },
    "CYBLE_VISION_ENABLE_NEWSFLASH": {
      "default": true,
      "description": "Import newsflash spot reports from the engine API.",
      "type": "boolean"
    },
    "CYBLE_VISION_ENGINE_PAGE_SIZE": {
      "default": 50,
      "description": "Page size for engine document APIs.",
      "maximum": 200,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN",
    "CYBLE_VISION_API_TOKEN"
  ],
  "additionalProperties": true
}