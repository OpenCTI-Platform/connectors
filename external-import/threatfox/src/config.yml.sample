opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  type: 'EXTERNAL_IMPORT'
  id: 'ChangeMe'

threatfox:
  # Set at least one of the two modes. With both, the commercial one wins and
  # the Auth-Key is the fallback.
  auth_key: 'ChangeMe' # Community mode, from https://auth.abuse.ch
  # spamhaus_username: 'ChangeMe' # Commercial mode, Spamhaus Customer Portal
  # spamhaus_password: 'ChangeMe'
