opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  type: 'EXTERNAL_IMPORT'
  id: 'd5067b93-7f6a-47e2-b76d-bb4ed69e270d' # Optional (default: 'd5067b93-7f6a-47e2-b76d-bb4ed69e270d')
  name: 'Intel471 v2' # Optional (default: 'Intel471 v2')
  scope: 'malware,vulnerability,indicator' # Optional (default: 'malware, vulnerability, indicator')
  log_level: 'info' # Optional (default: 'error')

intel471:
  api_username: ChangeMe
  api_key: ChangeMe
  interval_indicators: 60 # Optional (default: 0)
  initial_history_indicators: 0 # Optional (default: 0)
  interval_yara: 60 # Optional (default: 0)
  initial_history_yara: 0 # Optional (default: 0)
  interval_cves: 120 # Optional (default: 0)
  initial_history_cves: 0 # Optional (default: 0)
  interval_reports: 120 # Optional (default: 0)
  initial_history_reports: 0 # Optional (default: 0)
  interval_alerts: 0 # Optional (default: 0; Verity471 only, 0 disables the stream)
  initial_history_alerts: 0 # Optional (default: 0)
  watcher_group_ids: '' # Optional (Verity471 only; comma-separated watcher group IDs)
  watcher_ids: '' # Optional (Verity471 only; comma-separated watcher IDs)
  statuses: '' # Optional (Verity471 only; comma-separated: generated,needs_action,in_progress,completed,false_positive)
  is_trashed_included: false # Optional (default: false; Verity471 only)
  proxy: null # Optional (default: null)
  ioc_score: 70  # Optional (default: 70)
  backend: "titan" # Optional (default: "titan"; choices: "titan", "verity471")