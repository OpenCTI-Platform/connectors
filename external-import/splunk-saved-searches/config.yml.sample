opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  type: 'EXTERNAL_IMPORT'
  id: 'ChangeMe'
  name: 'Splunk Saved Searches'
  scope: 'Indicator,Attack-Pattern,SecurityPlatform'
  log_level: 'info'
  duration_period: 'PT6H'

