# OpenCTI parameters - REQUIRED
OPENCTI_URL=http://opencti:8080
OPENCTI_TOKEN=ChangeMe

# Connector's definition parameters - REQUIRED
CONNECTOR_ID=ChangeMe

# Connector's definition parameters - OPTIONAL
# CONNECTOR_NAME=Tenable Security Center
# CONNECTOR_SCOPE=vulnerability
# CONNECTOR_LOG_LEVEL=error
# CONNECTOR_DURATION_PERIOD=PT12H

# Tenable Security Center parameters - REQUIRED
TSC_API_BASE_URL=ChangeMe
TSC_API_ACCESS_KEY=ChangeMe
TSC_API_SECRET_KEY=ChangeMe
# Datetime (ISO-8601) of the first data retrieval.
# Overwritten by the connector state after the first successful run.
TSC_EXPORT_SINCE=2024-11-18T12:00:00Z

# Tenable Security Center parameters - OPTIONAL
# Minimum severity level: "info", "low", "medium", "high" or "critical"
# TSC_SEVERITY_MIN_LEVEL=high
# TSC_PROCESS_SYSTEMS_WITHOUT_VULNERABILITIES=false
# TSC_MARKING_DEFINITION=TLP:CLEAR
# TSC_API_TIMEOUT=30
# TSC_API_BACKOFF=5
# TSC_API_RETRIES=3
# TSC_NUMBER_THREADS=1
