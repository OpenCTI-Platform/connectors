{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/domaintools-iris-detect_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "DomainToolsIrisDetectConnector",
      "description": "The name of the connector.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "stix2"
      ],
      "description": "The scope of the connector.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "error",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "EXTERNAL_IMPORT",
      "default": "EXTERNAL_IMPORT",
      "type": "string"
    },
    "CONNECTOR_DURATION_PERIOD": {
      "default": "PT1H",
      "description": "The period of time to await between two runs of the connector.",
      "format": "duration",
      "type": "string"
    },
    "DOMAINTOOLS_API_BASE_URL": {
      "description": "API base URL.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "DOMAINTOOLS_API_KEY": {
      "description": "API key for authentication.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "DOMAINTOOLS_MONITOR_ID": {
      "default": null,
      "description": "Monitor ID from the monitors response \u2013 only used when requesting domains for specific monitors.",
      "type": "string"
    },
    "DOMAINTOOLS_STORE_IRIS_DATA": {
      "default": false,
      "description": "Store DomainTools Iris data as note object.",
      "type": "boolean"
    },
    "DOMAINTOOLS_PREVIEW": {
      "default": false,
      "description": "Use during API implementation and testing. Including with value = 1 will limit results to 2 but not be limited by hourly restrictions.",
      "type": "boolean"
    },
    "DOMAINTOOLS_TLP_LEVEL": {
      "default": "clear",
      "description": "Default TLP level of the imported entities.",
      "enum": [
        "clear",
        "white",
        "green",
        "amber",
        "amber+strict",
        "red"
      ],
      "type": "string"
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN",
    "DOMAINTOOLS_API_BASE_URL",
    "DOMAINTOOLS_API_KEY"
  ],
  "additionalProperties": true
}