{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/stairwell-import_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "Stairwell Import",
      "description": "The name of the connector.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "stairwell"
      ],
      "description": "The scope of the connector.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "error",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "EXTERNAL_IMPORT",
      "default": "EXTERNAL_IMPORT",
      "type": "string"
    },
    "CONNECTOR_DURATION_PERIOD": {
      "default": "P1D",
      "description": "Interval between two runs of the connector (ISO-8601).",
      "format": "duration",
      "type": "string"
    },
    "STAIRWELL_API_TOKEN": {
      "description": "Stairwell API token (Bearer auth).",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "STAIRWELL_API_BASE_URL": {
      "default": "https://app.stairwell.com",
      "description": "Stairwell API base URL.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "STAIRWELL_ORGANIZATION_ID": {
      "default": "",
      "description": "Optional Stairwell organization id (rate-limit header).",
      "type": "string"
    },
    "STAIRWELL_USER_ID": {
      "default": "",
      "description": "Optional Stairwell user id (rate-limit header).",
      "type": "string"
    },
    "STAIRWELL_IMPORT_TLP": {
      "default": "green",
      "description": "TLP marking applied to imported entities.",
      "enum": [
        "clear",
        "white",
        "green",
        "amber",
        "amber+strict",
        "red"
      ],
      "type": "string"
    },
    "STAIRWELL_IMPORT_FIRST_RUN_WINDOW": {
      "default": "P1D",
      "description": "ISO-8601 duration to backfill on the first run.",
      "type": "string"
    },
    "STAIRWELL_IMPORT_MAX_INDICATORS": {
      "default": 1000,
      "description": "Maximum indicators emitted per run.",
      "type": "integer"
    },
    "STAIRWELL_IMPORT_PAGE_SIZE": {
      "default": 100,
      "description": "Stairwell API page size.",
      "type": "integer"
    },
    "STAIRWELL_IMPORT_INDICATOR_VALIDITY_DAYS": {
      "default": 90,
      "description": "Days added to valid_from to compute valid_until.",
      "type": "integer"
    },
    "STAIRWELL_IMPORT_MIN_BUCKET": {
      "default": "HIGH",
      "description": "Minimum MalEval bucket: LOW, MEDIUM, HIGH, or VERY_HIGH.",
      "type": "string"
    },
    "STAIRWELL_IMPORT_SCOPE": {
      "default": "environment",
      "description": "Reserved (forward-compat): accepted but not yet effective; every run currently queries the full corpus regardless of this value.",
      "type": "string"
    },
    "STAIRWELL_IMPORT_WRAPPER": {
      "default": "grouping",
      "description": "Per-run wrapper SDO: 'grouping' or 'report'.",
      "enum": [
        "grouping",
        "report"
      ],
      "type": "string"
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN",
    "STAIRWELL_API_TOKEN"
  ],
  "additionalProperties": true
}