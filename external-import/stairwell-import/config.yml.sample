opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  type: 'EXTERNAL_IMPORT'
  id: 'ChangeMe'
  name: 'Stairwell Import' # optional (default: 'Stairwell Import')
  scope: 'stairwell' # optional (default: 'stairwell')
  log_level: 'error' # optional (default: 'error')
  duration_period: 'P1D' # optional, ISO-8601 interval between two runs (default: 'P1D')

stairwell_import:
  api_token: 'ChangeMe'
  api_base_url: 'https://app.stairwell.com' # optional
  organization_id: '' # optional, adds a rate-limit header
  user_id: '' # optional, adds a rate-limit header
  tlp: 'green' # optional, one of: clear, white, green, amber, amber+strict, red (default: 'green')
  first_run_window: 'P1D' # optional, ISO-8601 backfill window on first run (default: 'P1D')
  max_indicators: 1000 # optional (default: 1000)
  page_size: 100 # optional (default: 100)
  indicator_validity_days: 90 # optional (default: 90)
  min_bucket: 'HIGH' # optional, one of: LOW, MEDIUM, HIGH, VERY_HIGH (default: 'HIGH')
  scope: 'environment' # optional, reserved/not yet effective (default: 'environment')
  wrapper: 'grouping' # optional, 'grouping' or 'report' (default: 'grouping')
