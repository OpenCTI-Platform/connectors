{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/dogesec-siemrules_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "SIEM Rules",
      "description": "The name of the connector.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "siemrules"
      ],
      "description": "The scope of the connector.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "error",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "EXTERNAL_IMPORT",
      "default": "EXTERNAL_IMPORT",
      "type": "string"
    },
    "CONNECTOR_DURATION_PERIOD": {
      "default": "PT1H",
      "description": "The period of time to await between two runs of the connector.",
      "format": "duration",
      "type": "string"
    },
    "SIEMRULES_BASE_URL": {
      "default": "https://api.siemrules.com/",
      "description": "The base URL of the SIEM Rules API.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "SIEMRULES_API_KEY": {
      "description": "The API key used to authenticate to SIEM Rules Web.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "SIEMRULES_DETECTION_PACKS": {
      "default": [],
      "description": "A comma-separated list of SIEM Rules Detection Pack IDs to import. At least one is required: the connector stops when the list is empty.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "SIEMRULES_INTERVAL_HOURS": {
      "default": null,
      "deprecated": true,
      "type": "integer",
      "description": "Use CONNECTOR_DURATION_PERIOD instead."
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN",
    "SIEMRULES_API_KEY"
  ],
  "additionalProperties": true
}