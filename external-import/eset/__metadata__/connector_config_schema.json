{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/eset_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "ESET Cyber Threat Intelligence",
      "description": "The name of the connector.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "eset"
      ],
      "description": "The scope of the connector.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "error",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "EXTERNAL_IMPORT",
      "default": "EXTERNAL_IMPORT",
      "type": "string"
    },
    "CONNECTOR_DURATION_PERIOD": {
      "default": "PT1H",
      "description": "The period of time to await between two runs of the connector.",
      "format": "duration",
      "type": "string"
    },
    "ESET_API_URL": {
      "default": "eti.eset.com",
      "description": "Hostname of the ESET Threat Intelligence TAXII service.",
      "type": "string"
    },
    "ESET_USERNAME": {
      "description": "ESET Threat Intelligence username.",
      "type": "string"
    },
    "ESET_PASSWORD": {
      "description": "ESET Threat Intelligence password.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "ESET_COLLECTIONS": {
      "default": null,
      "description": "Comma-separated list of ESET TAXII collections to import. When unset (null), no collection is imported and only the APT reports are.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ESET_IMPORT_APT_REPORTS": {
      "default": true,
      "description": "Whether to import ESET APT reports.",
      "type": "boolean"
    },
    "ESET_IMPORT_START_DATE": {
      "default": "P30D",
      "description": "Start date (ISO 8601) from which data is imported on the first run. Either absolute (e.g. '2022-04-01') or relative (e.g. 'P30D' for 30 days ago).",
      "pattern": "^(?:(?!0000|0001|9999)(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)(?:[T ](?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|[+-](?:[01]\\d|2[0-3])(?::?[0-5]\\d)?)?)?|P(?!$)(?:\\d{1,3}Y)?(?:\\d{1,3}M)?(?:\\d{1,3}W)?(?:\\d{1,4}D)?(?:T(?=\\d)(?:\\d{1,4}H)?(?:\\d{1,4}M)?(?:\\d{1,4}(?:\\.\\d+)?S)?)?)$",
      "type": "string"
    },
    "ESET_CREATE_OBSERVABLES": {
      "default": false,
      "description": "Whether to create observables from imported indicators.",
      "type": "boolean"
    },
    "ESET_INTERVAL": {
      "default": null,
      "deprecated": true,
      "type": "integer",
      "description": "Use CONNECTOR_DURATION_PERIOD instead."
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN",
    "ESET_USERNAME",
    "ESET_PASSWORD"
  ],
  "additionalProperties": true
}