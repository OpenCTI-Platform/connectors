{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/dogesec-ctibutler_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "CTIButler",
      "description": "The name of the connector.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "ctibutler"
      ],
      "description": "The scope of the connector.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "error",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "EXTERNAL_IMPORT",
      "default": "EXTERNAL_IMPORT",
      "type": "string"
    },
    "CONNECTOR_DURATION_PERIOD": {
      "default": "P7D",
      "description": "The period of time to await between two runs of the connector.",
      "format": "duration",
      "type": "string"
    },
    "CTIBUTLER_BASE_URL": {
      "default": "https://api.ctibutler.com/",
      "description": "The URL of the CTI Butler API.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "CTIBUTLER_API_KEY": {
      "description": "The API key used to authenticate against the CTI Butler API.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CTIBUTLER_KNOWLEDGEBASES": {
      "description": "Comma-separated list of the knowledge bases to import, without spaces (e.g. 'attack-enterprise,capec'). Supported values: 'cwe', 'capec', 'location', 'attack-mobile', 'attack-ics', 'attack-enterprise', 'disarm', 'atlas'.",
      "type": "string"
    },
    "CTIBUTLER_INTERVAL_DAYS": {
      "default": null,
      "deprecated": true,
      "description": "Use CONNECTOR_DURATION_PERIOD instead.",
      "type": "integer"
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN",
    "CTIBUTLER_API_KEY",
    "CTIBUTLER_KNOWLEDGEBASES"
  ],
  "additionalProperties": true
}