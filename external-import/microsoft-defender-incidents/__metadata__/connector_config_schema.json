{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/microsoft-defender-incidents_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "Microsoft Defender Incidents",
      "description": "The name of the connector.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "defender"
      ],
      "description": "The scope of the connector.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "error",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "EXTERNAL_IMPORT",
      "default": "EXTERNAL_IMPORT",
      "type": "string"
    },
    "CONNECTOR_DURATION_PERIOD": {
      "default": "PT1H",
      "description": "The period of time to await between two runs of the connector.",
      "format": "duration",
      "type": "string"
    },
    "MICROSOFT_DEFENDER_INCIDENTS_TENANT_ID": {
      "description": "Azure Tenant ID for Microsoft Graph API authentication.",
      "type": "string"
    },
    "MICROSOFT_DEFENDER_INCIDENTS_CLIENT_ID": {
      "description": "Azure App Client ID for Microsoft Graph API authentication.",
      "type": "string"
    },
    "MICROSOFT_DEFENDER_INCIDENTS_CLIENT_SECRET": {
      "description": "Azure App Client Secret for Microsoft Graph API authentication.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "MICROSOFT_DEFENDER_INCIDENTS_IMPORT_START_DATE": {
      "default": "P30D",
      "description": "Start date for importing incidents, as an ISO-8601 datetime (e.g. '2025-01-01T00:00:00Z') or duration relative to now (e.g. 'P30D' for 30 days ago). Used only on the first run; subsequent runs use the stored state.",
      "pattern": "^(?:(?!0000|0001|9999)(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)(?:[T ](?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|[+-](?:[01]\\d|2[0-3])(?::?[0-5]\\d)?)?)?|P(?!$)(?:\\d{1,3}Y)?(?:\\d{1,3}M)?(?:\\d{1,3}W)?(?:\\d{1,4}D)?(?:T(?=\\d)(?:\\d{1,4}H)?(?:\\d{1,4}M)?(?:\\d{1,4}(?:\\.\\d+)?S)?)?)$",
      "type": "string"
    },
    "MICROSOFT_DEFENDER_INCIDENTS_API_BASE_URL": {
      "default": "https://graph.microsoft.com/v1.0",
      "description": "Microsoft Graph API base URL.",
      "type": "string"
    },
    "MICROSOFT_DEFENDER_INCIDENTS_INCIDENT_PATH": {
      "default": "/security/incidents",
      "description": "Microsoft Graph API path for retrieving security incidents.",
      "type": "string"
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN",
    "MICROSOFT_DEFENDER_INCIDENTS_TENANT_ID",
    "MICROSOFT_DEFENDER_INCIDENTS_CLIENT_ID",
    "MICROSOFT_DEFENDER_INCIDENTS_CLIENT_SECRET"
  ],
  "additionalProperties": true
}