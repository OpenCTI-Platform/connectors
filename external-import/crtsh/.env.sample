OPENCTI_URL=http://localhost
# Use one as provided by the platform
OPENCTI_TOKEN=ChangeMe
# Generate one with uuidgen
CONNECTOR_ID=ChangeMe
# CONNECTOR_NAME=crt.sh
# CONNECTOR_SCOPE=crtsh
# One of the following: debug, info, warning, error
# CONNECTOR_LOG_LEVEL=error
# ISO8601 duration, e.g. PT1H, P1D
# CONNECTOR_DURATION_PERIOD=PT1H
# Connector specific parameters.
# Domain to search for e.g., google.com
CRTSH_DOMAIN=ChangeMe
# Comma separated list of labels e.g., crtsh,osint
# CRTSH_LABELS=crtsh,osint
# TLP Marking Refs e.g., TLP:WHITE, TLP:GREEN, TLP:AMBER, TLP:RED (no marking if not set)
# CRTSH_MARKING_REFS=TLP:WHITE
# Filters expired certificates. One of the following: true, false
# CRTSH_IS_EXPIRED=false
# Applies a wildcard expression for the Domain. One of the following: true, false
# CRTSH_IS_WILDCARD=false
