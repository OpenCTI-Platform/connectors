{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/crtsh_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "crt.sh",
      "description": "The name of the connector.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "crtsh"
      ],
      "description": "The scope of the connector.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "error",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "EXTERNAL_IMPORT",
      "default": "EXTERNAL_IMPORT",
      "type": "string"
    },
    "CONNECTOR_DURATION_PERIOD": {
      "default": "PT1H",
      "description": "The period of time to await between two runs of the connector.",
      "format": "duration",
      "type": "string"
    },
    "CONNECTOR_RUN_EVERY": {
      "default": null,
      "deprecated": true,
      "type": "string",
      "description": "Use CONNECTOR_DURATION_PERIOD instead."
    },
    "CRTSH_DOMAIN": {
      "description": "Domain to search certificates for (e.g. 'google.com').",
      "type": "string"
    },
    "CRTSH_LABELS": {
      "default": [
        "crtsh",
        "osint"
      ],
      "description": "Comma-separated list of labels to add to the imported objects (e.g. 'crtsh,osint').",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CRTSH_MARKING_REFS": {
      "default": null,
      "description": "TLP marking to apply to the imported objects. If not set, no marking is applied.",
      "enum": [
        "TLP:WHITE",
        "TLP:GREEN",
        "TLP:AMBER",
        "TLP:RED"
      ],
      "type": "string"
    },
    "CRTSH_IS_EXPIRED": {
      "default": false,
      "description": "Whether to exclude expired certificates from the search.",
      "type": "boolean"
    },
    "CRTSH_IS_WILDCARD": {
      "default": false,
      "description": "Whether to apply a wildcard expression to the domain (search its subdomains).",
      "type": "boolean"
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN",
    "CRTSH_DOMAIN"
  ],
  "additionalProperties": true
}