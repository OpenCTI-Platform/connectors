{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/spycloud_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "SpyCloud",
      "description": "The name of the connector.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "spycloud"
      ],
      "description": "The scope of the connector.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "info",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "EXTERNAL_IMPORT",
      "default": "EXTERNAL_IMPORT",
      "type": "string"
    },
    "CONNECTOR_DURATION_PERIOD": {
      "default": "PT1H",
      "description": "The period of time to await between two runs of the connector.",
      "format": "duration",
      "type": "string"
    },
    "SPYCLOUD_API_BASE_URL": {
      "description": "SpyCloud API base URL (a trailing slash is added if missing).",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "SPYCLOUD_API_KEY": {
      "description": "SpyCloud API key.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "SPYCLOUD_SEVERITY_LEVELS": {
      "default": [],
      "description": "Comma-separated list of severities to filter breach records (allowed values are 2, 5, 20, 25). Leave empty to import all severities.",
      "items": {
        "enum": [
          2,
          5,
          20,
          25
        ],
        "type": "integer"
      },
      "type": "array"
    },
    "SPYCLOUD_WATCHLIST_TYPES": {
      "default": [],
      "description": "Comma-separated list of watchlist types to filter breach records (allowed values are 'email', 'domain', 'subdomain', 'ip'). Leave empty to import all watchlist types.",
      "items": {
        "enum": [
          "email",
          "domain",
          "subdomain",
          "ip"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "SPYCLOUD_TLP_LEVEL": {
      "default": "amber+strict",
      "description": "TLP level to set on imported entities.",
      "enum": [
        "white",
        "green",
        "amber",
        "amber+strict",
        "red"
      ],
      "type": "string"
    },
    "SPYCLOUD_IMPORT_START_DATE": {
      "default": "P30D",
      "description": "The date to start importing breach records from, used only if the connector's state is not set. Can be either absolute (ISO 8601 date, e.g. '2024-01-01T00:00:00Z') or relative (ISO 8601 duration, e.g. 'P30D' for 30 days ago).",
      "pattern": "^(?:(?!0000|0001|9999)(?:\\d{4}-(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|\\d{4}-(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|\\d{4}-02-(?:0[1-9]|1\\d|2[0-8])|(?:\\d\\d(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)(?:[T ](?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|[+-](?:[01]\\d|2[0-3])(?::?[0-5]\\d)?)?)?|P(?!$)(?:\\d{1,3}Y)?(?:\\d{1,3}M)?(?:\\d{1,3}W)?(?:\\d{1,4}D)?(?:T(?=\\d)(?:\\d{1,4}H)?(?:\\d{1,4}M)?(?:\\d{1,4}(?:\\.\\d+)?S)?)?)$",
      "type": "string"
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN",
    "SPYCLOUD_API_BASE_URL",
    "SPYCLOUD_API_KEY"
  ],
  "additionalProperties": true
}