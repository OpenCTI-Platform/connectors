opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  type: 'EXTERNAL_IMPORT'
  id: 'ChangeMe'
  name: 'Abuse.ch URLhaus'
  scope: 'urlhaus'
  log_level: 'info'

urlhaus:
  auth_key: 'ChangeMe' # From https://auth.abuse.ch
  default_x_opencti_score: 80  # Optional: Defaults to 80
  import_offline: true
  interval: 3
  threats_from_labels: true
