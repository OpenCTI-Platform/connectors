{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/domaintools-feeds_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "DomainToolsFeedsConnector",
      "description": "The name of the connector.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "domaintools-feeds"
      ],
      "description": "The scope of the connector.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "error",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "EXTERNAL_IMPORT",
      "default": "EXTERNAL_IMPORT",
      "type": "string"
    },
    "CONNECTOR_DURATION_PERIOD": {
      "default": "PT1H",
      "description": "The period of time to await between two runs of the connector.",
      "format": "duration",
      "type": "string"
    },
    "DOMAINTOOLS_API_BASE_URL": {
      "description": "API base URL.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "DOMAINTOOLS_API_KEY": {
      "description": "API key for authentication.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "DOMAINTOOLS_FEED_TYPE": {
      "description": "Name of the feed.",
      "enum": [
        "domainhotlist",
        "domainrisk",
        "nod",
        "nad",
        "noh",
        "domaindiscovery"
      ],
      "type": "string"
    },
    "DOMAINTOOLS_SESSION_ID": {
      "default": "OpenCTI-DomainTools-Feeds",
      "description": "A unique identifier for the session, used for resuming data retrieval from the last point.",
      "type": "string"
    },
    "DOMAINTOOLS_DOMAIN": {
      "default": null,
      "description": "Filter for an exact domain or a domain substring by prefixing or suffixing your string with *.",
      "type": "string"
    },
    "DOMAINTOOLS_TOP": {
      "default": null,
      "description": "Limits the number of results in the response payload. Primarily intended for testing.",
      "type": "integer"
    },
    "DOMAINTOOLS_TLP_LEVEL": {
      "default": "clear",
      "description": "Default TLP level of the imported entities.",
      "enum": [
        "clear",
        "white",
        "green",
        "amber",
        "amber+strict",
        "red"
      ],
      "type": "string"
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN",
    "DOMAINTOOLS_API_BASE_URL",
    "DOMAINTOOLS_API_KEY",
    "DOMAINTOOLS_FEED_TYPE"
  ],
  "additionalProperties": true
}