{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/dogesec-cyberthreatexchange_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "CyberThreatExchange",
      "description": "The name of the connector.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "cyberthreatexchange"
      ],
      "description": "The scope of the connector.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "error",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "EXTERNAL_IMPORT",
      "default": "EXTERNAL_IMPORT",
      "type": "string"
    },
    "CONNECTOR_DURATION_PERIOD": {
      "default": "PT1H",
      "description": "The period of time to await between two runs of the connector.",
      "format": "duration",
      "type": "string"
    },
    "CYBERTHREATEXCHANGE_BASE_URL": {
      "default": "https://api.cyberthreatexchange.com/",
      "description": "The base URL of the Cyber Threat Exchange API.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "CYBERTHREATEXCHANGE_API_KEY": {
      "description": "The API key used to authenticate to the Cyber Threat Exchange API.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CYBERTHREATEXCHANGE_FEED_IDS": {
      "default": [],
      "description": "Comma-separated list of the IDs of the subscribed feeds to import (e.g. 'f0895eb3-7d90-4b45-8664-a7e157ba880f,b63c638e-43e6-43d4-bfac-5b71c264b132'). At least one feed ID is required: the connector stops at startup otherwise.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CYBERTHREATEXCHANGE_INTERVAL_HOURS": {
      "default": null,
      "deprecated": true,
      "description": "Use CONNECTOR_DURATION_PERIOD instead.",
      "type": "integer"
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN",
    "CYBERTHREATEXCHANGE_API_KEY"
  ],
  "additionalProperties": true
}