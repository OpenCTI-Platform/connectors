{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.filigran.io/connectors/ransomwarelive_config.schema.json",
  "type": "object",
  "properties": {
    "OPENCTI_URL": {
      "description": "The base URL of the OpenCTI instance.",
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "type": "string"
    },
    "OPENCTI_TOKEN": {
      "description": "The API token to connect to OpenCTI.",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "CONNECTOR_NAME": {
      "default": "Ransomware Connector",
      "description": "The connector name displayed in OpenCTI.",
      "type": "string"
    },
    "CONNECTOR_SCOPE": {
      "default": [
        "identity",
        "attack-pattern",
        "course-of-action",
        "intrusion-set",
        "malware",
        "tool",
        "report"
      ],
      "description": "Comma-separated STIX entity scope for this connector.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "CONNECTOR_LOG_LEVEL": {
      "default": "error",
      "description": "The minimum level of logs to display.",
      "enum": [
        "debug",
        "info",
        "warn",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "CONNECTOR_TYPE": {
      "const": "EXTERNAL_IMPORT",
      "default": "EXTERNAL_IMPORT",
      "type": "string"
    },
    "CONNECTOR_DURATION_PERIOD": {
      "default": "PT10M",
      "description": "Duration between two scheduled runs of the connector.",
      "format": "duration",
      "type": "string"
    },
    "CONNECTOR_RUN_EVERY": {
      "default": null,
      "deprecated": true,
      "type": "string",
      "description": "Use CONNECTOR_DURATION_PERIOD instead."
    },
    "CONNECTOR_PULL_HISTORY": {
      "default": null,
      "deprecated": true,
      "type": "boolean",
      "description": "Use RANSOMWARELIVE_PULL_HISTORY instead."
    },
    "CONNECTOR_HISTORY_START_YEAR": {
      "default": null,
      "deprecated": true,
      "exclusiveMinimum": 0,
      "type": "integer",
      "description": "Use RANSOMWARELIVE_HISTORY_START_YEAR instead."
    },
    "CONNECTOR_CREATE_THREAT_ACTOR": {
      "default": null,
      "deprecated": true,
      "type": "boolean",
      "description": "Use RANSOMWARELIVE_CREATE_THREAT_ACTOR instead."
    },
    "CONNECTOR_CREATE_INTRUSION_SET": {
      "default": null,
      "deprecated": true,
      "type": "boolean",
      "description": "Use RANSOMWARELIVE_CREATE_INTRUSION_SET instead."
    },
    "CONNECTOR_CREATE_CAMPAIGN": {
      "default": null,
      "deprecated": true,
      "type": "boolean",
      "description": "Use RANSOMWARELIVE_CREATE_CAMPAIGN instead."
    },
    "CONNECTOR_CREATE_REPORT": {
      "default": null,
      "deprecated": true,
      "type": "boolean",
      "description": "Use RANSOMWARELIVE_CREATE_REPORT instead."
    },
    "CONNECTOR_CREATE_LEAK_SITE_DOMAINS": {
      "default": null,
      "deprecated": true,
      "type": "boolean",
      "description": "Use RANSOMWARELIVE_CREATE_LEAK_SITE_DOMAINS instead."
    },
    "CONNECTOR_CREATE_LEAK_POST_REFS": {
      "default": null,
      "deprecated": true,
      "type": "boolean",
      "description": "Use RANSOMWARELIVE_CREATE_LEAK_POST_REFS instead."
    },
    "CONNECTOR_MARKING_VALUE": {
      "default": null,
      "deprecated": true,
      "enum": [
        "TLP:CLEAR",
        "TLP:WHITE",
        "TLP:GREEN",
        "TLP:AMBER",
        "TLP:AMBER+STRICT",
        "TLP:RED"
      ],
      "type": "string",
      "description": "Use RANSOMWARELIVE_MARKING_VALUE instead."
    },
    "RANSOMWARELIVE_API_BASE_URL": {
      "default": "https://api.ransomware.live/v2",
      "description": "Ransomware.live API base URL.",
      "enum": [
        "https://api.ransomware.live/v2",
        "https://api-pro.ransomware.live"
      ],
      "type": "string"
    },
    "RANSOMWARELIVE_API_KEY": {
      "default": null,
      "description": "API key sent in `X-API-KEY` header (required for Ransomware.live API PRO use only).",
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "RANSOMWARELIVE_PULL_HISTORY": {
      "default": false,
      "description": "Whether to pull historic data. It is not recommended to set it to `true` as there will be a large influx of data.",
      "type": "boolean"
    },
    "RANSOMWARELIVE_HISTORY_START_YEAR": {
      "default": 2023,
      "description": "Year (or YYYYMM) to start historical backfill from. Values older than `2020` are clamped to `2020-01` at runtime.",
      "exclusiveMinimum": 0,
      "type": "integer"
    },
    "RANSOMWARELIVE_CREATE_THREAT_ACTOR": {
      "default": false,
      "description": "Whether to create a Threat Actor object.",
      "type": "boolean"
    },
    "RANSOMWARELIVE_CREATE_INTRUSION_SET": {
      "default": true,
      "description": "Whether to create an Intrusion Set object.",
      "type": "boolean"
    },
    "RANSOMWARELIVE_CREATE_CAMPAIGN": {
      "default": false,
      "description": "Whether to create a Campaign object.",
      "type": "boolean"
    },
    "RANSOMWARELIVE_CREATE_REPORT": {
      "default": true,
      "description": "Whether to create a Report object.",
      "type": "boolean"
    },
    "RANSOMWARELIVE_CREATE_LEAK_SITE_DOMAINS": {
      "default": false,
      "description": "Whether to create DomainName observables for ransomware group leak sites and link them to the IntrusionSet.",
      "type": "boolean"
    },
    "RANSOMWARELIVE_CREATE_LEAK_POST_REFS": {
      "default": false,
      "description": "Whether to include the leak post URL as a report external reference.",
      "type": "boolean"
    },
    "RANSOMWARELIVE_MARKING_VALUE": {
      "default": "TLP:CLEAR",
      "description": "TLP marking attached to every emitted STIX object.",
      "enum": [
        "TLP:CLEAR",
        "TLP:WHITE",
        "TLP:GREEN",
        "TLP:AMBER",
        "TLP:AMBER+STRICT",
        "TLP:RED"
      ],
      "type": "string"
    }
  },
  "required": [
    "OPENCTI_URL",
    "OPENCTI_TOKEN"
  ],
  "additionalProperties": true
}