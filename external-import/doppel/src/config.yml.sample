opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  type: 'EXTERNAL_IMPORT'
  id: 'ChangeMe'  # Valid UUIDv4
  name: 'Doppel Threat Intelligence'
  scope: 'doppel'
  log_level: 'info'
  duration_period: 'PT1H'  # Interval given for scheduler process in ISO-8601 format

doppel:
  api_base_url: 'https://api.doppel.com'

  # Choose exactly one authentication block. Do not configure V1 and V2
  # credentials together.
  api_version: 'v1'

  # V1 only
  api_key: 'ChangeMe'
  user_api_key: null
  organization_code: null

  # V2 only: set api_version to 'v2', remove the V1 fields above, and uncomment:
  # client_id: 'ChangeMe'
  # client_secret: 'ChangeMe'
  # token_url: null # defaults to https://api.doppel.com/oauth/token
  # token_audience: 'doppel-external'

  tlp_level: 'clear'  # available values are: clear, white, green, amber, amber+strict, red
  alerts_endpoint: '/alerts'
  historical_polling_days: 30
  max_retries: 3
  retry_delay: 30
  page_size: 100
