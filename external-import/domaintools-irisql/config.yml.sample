opencti:
  url: 'http://localhost'
  token: 'ChangeMe'

connector:
  id: 'ChangeMe'
  # name: 'DomainToolsIrisQLConnector' # optional
  # scope: 'stix2' # optional
  # log_level: 'error' # optional
  # duration_period: 'PT1H' # optional, interval in ISO-8601 format between two runs of the connector

domaintools:
  api_base_url: 'https://api.domaintools.com/v1/iris-investigate/'
  api_key: 'ChangeMe'
  iris_ql: 'ChangeMe' # e.g. "# IrisQL-1.0\ndomain contains \"sso\"\nAND\nfirst_seen within \"the last 1 hour\"\nAND\nrisk_score greater_than_or_equal \"90\""
  # store_iris_data: false # optional
  # tlp_level: 'clear' # optional, available values: 'clear', 'white', 'green', 'amber', 'amber+strict', 'red'
